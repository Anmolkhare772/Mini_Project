# 🛡️ CYBERSHIELD CONFIGURATION TEMPLATE
# Copy this to .env and fill in your real credentials

# ── Flask & Security ───────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=generate_a_strong_secret_key_here
JWT_SECRET_KEY=generate_another_strong_key

# ── Database ───────────────────────────────────────────────────
# For Production, use PostgreSQL: postgresql://user:pass@host:5432/dbname
# For Local, SQLite is used by default: sqlite:///app.db
DATABASE_URL=sqlite:///app.db

# ── AWS Credentials (Required for S3/CloudWatch) ───────────────
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# ── S3 Log Ingestion ───────────────────────────────────────────
S3_BUCKET_NAME=your-threat-logs-bucket
S3_POLL_INTERVAL=30

# ── Cloud Analytics (Kinesis) ──────────────────────────────────
CLOUD_ANALYTICS_ENABLED=false
CLOUD_ANALYTICS_STREAM=cybershield-analytics-stream

# ── API Keys ───────────────────────────────────────────────────
# Used for secure Lambda -> Backend communication
AWS_LAMBDA_API_KEY=mysecret123
