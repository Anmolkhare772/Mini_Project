# CyberShield Sentinel — Environment Configuration
# Copy this file to .env and fill in your values
# Never commit the real .env to Git

# ── Flask Security ──────────────────────────────────────────────
SECRET_KEY=cybershield-super-secret-key-2025
JWT_SECRET_KEY=jwt-cybershield-secret-2025

# ── AWS S3 Integration ──────────────────────────────────────────
# Get these from AWS Console → IAM → Your User → Security Credentials
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_REGION=us-east-1

# The S3 bucket where Lambda writes logs
S3_BUCKET_NAME=cybershield-logs

# The prefix (folder) inside the bucket where Lambda writes log files
# Lambda should write to: s3://cybershield-logs/logs/YYYY-MM-DD/filename.json
S3_KEY_PREFIX=logs/
